# ============================================================
# ReviewFlow AI v3.12.0 — Plantilla de variables de entorno
# ------------------------------------------------------------
# Copia este fichero a `.env` y pega TUS claves reales:
#     cp .env.example .env
#
# En desarrollo puede arrancar en modo demo. En producción valida y exige
# Supabase, Stripe, URL HTTPS y los secretos internos antes de aceptar tráfico.
#
# Guía paso a paso de cada credencial:
#     GUIA_PASOS_MANUALES.md (secciones 1 → 8)
# Despliegue:  GUIA_GRATIS.md (0 €) · GUIA_DESPLIEGUE.md (producción) · GUIA_AUTOMATIZACION.md
#
# ⚠️ NUNCA subas el `.env` real a Git (ya está en .gitignore).
# ⚠️ Variables con prefijo NEXT_PUBLIC_ se envían al navegador: solo las
#    necesarias (URL, anon key de Supabase, publishable key de Stripe).
# ============================================================

# ---------- 1. App ----------
# URL pública final SIN barra al final. Se usa en webhooks, OAuth y emails.
# Producción:  https://tudominio.com     ·   Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# ---------- 1b. Datos legales / empresa (S.L.) ----------
# Fuente única de verdad para el footer y las páginas legales
# (/aviso-legal, /privacidad, /terminos). Ver lib/site.ts.
# Si se dejan vacías se muestran los placeholders [ENTRE CORCHETES].
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_CIF=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_DOMAIN=

# ---------- 2. Super-Admin (panel /admin) ----------
# Emails con acceso total al panel interno, separados por comas y en minúsculas.
# ¡Usa tu email real o el panel quedará en modo demo!
SUPERADMIN_EMAILS=tu@email.com

# ---------- 3. Supabase (Postgres + Auth + RLS) ----------
# Panel de Supabase → tu proyecto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
# «anon public» key: segura para el navegador (respeta RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# «service_role» key: SOLO servidor. Salta RLS; si se filtra, rota la clave.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Tras pegarlas, ejecuta supabase/schema.sql (proyecto nuevo) o las migraciones
# supabase/migration_3_7_0.sql → migration_3_8_0.sql → migration_3_9_0.sql → migration_3_10_0.sql → migration_3_11_0.sql → migration_3_12_0.sql (proyecto existente).

# Cadena de conexión DIRECTA a PostgreSQL (OPCIONAL pero recomendada).
# Úsala SOLO con el Connection Pooler de Supabase (Supavisor):
#   Dashboard → Project Settings → Database → Connection string → Connection pooling
#     · Transaction mode (puerto 6543) → ideal para Vercel/serverless
#     · Session mode (puerto 5432 del host del pooler) → ideal para VPS/Docker
# La app usa PostgREST para el CRUD; este pool sirve para diagnóstico
# (/api/admin/db y /api/admin/db), mantenimiento (purga) y analítica.
# DATABASE_URL=postgresql://postgres.abcdefgh:TU_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Ajustes del pool (opcionales):
# DATABASE_POOL_MAX=5                 # conexiones por instancia (Vercel: 3-5)
# DATABASE_IDLE_TIMEOUT_MS=10000
# DATABASE_CONNECT_TIMEOUT_MS=8000
# DATABASE_STATEMENT_TIMEOUT_MS=8000  # corta consultas lentas
# DATABASE_SSL=require                # require | prefer | disable

# ---------- 4. Stripe (2 planes de pago + recargas puntuales) ----------
# Dashboard → Developers → API keys. En producción usa las claves LIVE.
STRIPE_SECRET_KEY=sk_test_...
# Publishable key (se expone al navegador; no permite cobrar).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dashboard → Developers → Webhooks → endpoint https://tudominio.com/api/stripe/webhook
# Eventos: checkout.session.completed · customer.subscription.{created,updated,deleted}
#          · invoice.payment_failed · invoice.paid · trial_will_end
STRIPE_WEBHOOK_SECRET=whsec_...

# Planes (Product catalog → precios MENSUALES en EUR).
#   Pro      29 €/mes ·  500 peticiones ·  1.000 opiniones · 300 IA · 120 syncs
#   Business 79 €/mes · 2.000 peticiones · 5.000 opiniones · 1.500 IA · 720 syncs
# Sin plan gratuito: los 2 planes pasan por Stripe con prueba de 7 días (la aplica el código).
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
# Compatibilidad con nombres antiguos (opcionales, se leen como respaldo):
# STRIPE_PRICE_RESENAS=price_...    # → Pro
# STRIPE_PRICE_STARTER=price_...    # → Pro
# STRIPE_PRICE_COMPLETO=price_...   # → Business
# Prueba gratuita de los planes de pago: 7 días (TRIAL_DAYS en lib/plans.ts).

# Recargas puntuales (pago único, amplían el ciclo en curso).
# OPCIONALES: si las dejas vacías, /api/stripe/addon crea la línea con
# `price_data` inline usando los importes de lib/plans.ts.
# Cómo crearlas paso a paso: docs/GUIA_PASOS_MANUALES.md → sección 5.
STRIPE_PRICE_ADDON_REQUESTS=price_...   # +1.000 peticiones    ·  9 €
STRIPE_PRICE_ADDON_REVIEWS=price_...    # +2.000 opiniones     · 12 €
STRIPE_PRICE_ADDON_AI=price_...         # +500 respuestas IA   · 15 €
STRIPE_PRICE_ADDON_SYNCS=price_...      # +500 sincronizaciones ·  6 €
# Importes alternativos en CÉNTIMOS si no defines los Price ID anteriores:
# STRIPE_ADDON_REQUESTS_PRICE_CENTS=900
# STRIPE_ADDON_REVIEWS_PRICE_CENTS=1200
# STRIPE_ADDON_AI_PRICE_CENTS=1500
# STRIPE_ADDON_SYNCS_PRICE_CENTS=600

# ---------- 5. SMTP (emails transaccionales) ----------
# Cualquier proveedor: Brevo, Postmark, Amazon SES, Mailgun, Gmail App Password…
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp
SMTP_FROM=ReviewFlow AI <no-reply@tudominio.com>
# Recuerda publicar SPF + DKIM + DMARC en tu DNS (GUIA_PASOS_MANUALES.md → 6).

# ---------- 6. OpenAI (IA centralizada en lib/openai.ts) — OPCIONAL ----------
# Sin esta clave la app sigue funcionando al 100% usando plantillas y
# heurísticas locales (fallback). Plataforma → API keys → «Create new secret key».
# Cada borrador consume 1 crédito de IA + sus tokens del presupuesto del plan.
OPENAI_API_KEY=sk-...
# Modelo (por defecto gpt-4o-mini, el más económico de la familia GPT-4o).
OPENAI_MODEL=gpt-4o-mini
# Endpoint alternativo (Azure OpenAI, OpenRouter, proxy corporativo). Opcional.
# OPENAI_BASE_URL=https://tu-proxy.example.com/v1
# Blindaje del cliente de IA (todos opcionales; valores por defecto a la derecha):
# OPENAI_TIMEOUT_MS=20000        # timeout por petición
# OPENAI_MAX_ATTEMPTS=3          # reintentos con backoff exponencial + jitter
# OPENAI_RPM_PER_TENANT=20       # peticiones/minuto por EMPRESA (anti-bucle)
# OPENAI_MAX_CONCURRENCY=6       # peticiones simultáneas al proveedor (global)

# ---------- 7. Google (reseñas reales) ----------
# 7a. OAuth Google Business Profile (importar + PUBLICAR respuestas):
#     console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
#     Authorized redirect URI EXACTA: https://tudominio.com/api/integrations/google/callback
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# 7b. Google Places API (New) — clave de SERVIDOR, opcional:
#     permite leer reseñas por Place ID sin OAuth del propietario.
#     Restringe la clave por API y por IP del servidor.
# GOOGLE_PLACES_API_KEY=AIzaSy...

# ---------- 8. Meta WhatsApp Cloud API (alertas ≤3★ y post-venta) ----------
# developers.facebook.com → tu app → producto WhatsApp → API Setup.
# Token temporal de pruebas (24 h) o permanente (System User, recomendado en producción).
# WHATSAPP_TOKEN=EAAB...
# Phone Number ID del número emisor (no es el teléfono): apartado «API Setup».
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WhatsApp Business Account ID (necesario para plantillas y usuarios del sistema).
# WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
# Versión de la Graph API (opcional; por defecto v21.0).
# WHATSAPP_API_VERSION=v21.0
# Token que TÚ inventas para verificar el webhook de Meta (opcional).
# WHATSAPP_VERIFY_TOKEN=cadena-larga-aleatoria
#
# ---- Plantillas HSM aprobadas (OBLIGATORIAS fuera de la ventana de 24 h) ----
# Créalas en tu app → WhatsApp → Message Templates (categoría UTILITY) con
# el idioma de abajo y estos cuerpos (ver GUIA_AUTOMATIZACION.md §3):
#   solicitud_valoracion: «Hola {{1}} 🎉, tu pedido {{2}} de {{3}} ha sido entregado.
#     ¿Nos ayudas con tu valoración (30 segundos)? {{4}}»
#   alerta_resena: «🎫 Ticket {{1}} en {{2}}: {{3}}» (aviso interno al dueño)
# WHATSAPP_TEMPLATE_REVIEW_REQUEST=solicitud_valoracion
# WHATSAPP_TEMPLATE_ALERT=alerta_resena
# WHATSAPP_TEMPLATE_LANG=es
#
# ---- Opt-in RGPD (recomendado: true) ----
# Con 'true' no sale ningún WhatsApp al CLIENTE sin consentimiento registrado
# (checkbox del checkout → whatsapp_optins). Pon 'false' solo en migración.
WHATSAPP_REQUIRE_OPTIN=true

# ---------- 8b. TripAdvisor (reseñas vía intermediario) — OPCIONAL ----------
# TripAdvisor no tiene API pública: elige proveedor y pega su clave.
# Cada empresa guarda su Location ID (dXXXXXX) en el panel → Empresa.
# TRIPADVISOR_PROVIDER=serpapi            # 'serpapi' | 'outscraper'
# SERPAPI_API_KEY=...                     # serpapi.com (engine tripadvisor_review)
# OUTSCRAPER_API_KEY=...                  # outscraper.com (task tripadvisor-reviews)

# ---------- 8c. Cron + Cola (automatización) — OPCIONAL ----------
# CRON_SECRET protege /api/cron/sync-reviews (Bearer o ?secret=).
# Vercel Cron lo envía solo si la variable existe (ver vercel.json).
# Genera uno: openssl rand -hex 32
# CRON_SECRET=cadena-larga-aleatoria
# Upstash QStash (console.upstash.com → QStash): encola entregas, IAs,
# WhatsApps y syncs en segundo plano. Sin esto todo funciona EN LÍNEA.
# QSTASH_TOKEN=...
# QSTASH_CURRENT_SIGNING_KEY=sig_...
# QSTASH_NEXT_SIGNING_KEY=sig_...

# ---------- 9. Verificación antes de vender ----------
# `npm run verify` comprueba health, motor de IA, pool de PostgreSQL, webhook de
# Stripe (firma válida → 200 / firma falsa → 400) y que las rutas de IA no se
# ejecutan sin sesión.
# Para ello necesita leer estas variables del entorno o del .env (arriba).

# ---------- 10. Analítica opcional (RGPD: solo con consentimiento) ----------
# Plausible no usa cookies; si lo configuras, se carga solo tras aceptar analítica.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tudominio.com

# ------------------------------------------------------------
# Lo siguiente NO va en el .env: se configura POR EMPRESA desde el panel
# (pestaña «Empresa»): Trustpilot API key + Business Unit ID, TripAdvisor
# Location ID, Place ID de Google Maps, móvil de alertas, tono de IA,
# Shopify/WooCommerce (URL + secreto HMAC) y la api_key de la API pública
# de ingesta. Pestaña «Embudo»: URLs públicas de TripAdvisor/Trustpilot.
# ------------------------------------------------------------

# ---------- 11. Seguridad interna obligatoria en producción ----------
# Genera valores independientes con: openssl rand -hex 32
APP_SIGNING_SECRET=
INTEGRATION_ENCRYPTION_KEY=
# Durante una rotación, conserva temporalmente la clave anterior y ejecuta el endpoint admin.
# INTEGRATION_ENCRYPTION_KEY_PREVIOUS=
PRIVACY_HASH_PEPPER=
HEALTHCHECK_SECRET=
# App Secret de Meta Developers; autentica X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
